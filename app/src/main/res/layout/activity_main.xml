<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a0a"
    android:padding="12dp">
    <TextView
        android:id="@+id/headerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="heretic :: 127.0.0.1:8080"
        android:textColor="#4a7a55"
        android:textSize="12sp"
        android:typeface="monospace" />
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Heretic — checking server…"
        android:textColor="#6fae7d"
        android:textSize="13sp"
        android:typeface="monospace" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#222222" />
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/chatText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Heretic is Ryan's own model. Trusts Ryan implicitly.\n\nType below to talk. Tools: calculator, time, notes, press_claim, label_evidence, virtue_frame."
            android:textColor="#d0d0d0"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:typeface="monospace" />
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingEnd="6dp"
            android:text=">"
            android:textColor="#4ade80"
            android:textSize="18sp"
            android:typeface="monospace" />
        <EditText
            android:id="@+id/inputText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1a1a1a"
            android:padding="10dp"
            android:hint="Talk to Heretic…"
            android:textColor="#e8e0d0"
            android:textColorHint="#666666"
            android:textSize="15sp"
            android:typeface="monospace" />
        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#1f2a1f"
            android:text="Send"
            android:textColor="#4ade80"
            android:textSize="15sp"
            android:typeface="monospace" />
    </LinearLayout>
</LinearLayout>
